From 070f5c9b098d0ad7fa5177eb688e90928995ee6b Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Sat, 7 Nov 2026 21:20:39 +0000
Subject: [PATCH] qsort: end, and stay inside the array, for every comparison
 function

qsort took the middle element as the pivot and left it in the array,
where the scan from the left stopped at it only because
compar(pivot, pivot) returned 0. A comparison function that never
returns 0 (libwebp's Huffman-tree and palette sorts:
"return (a < b) ? -1 : 1;") made that scan run past the pivot and past
the end of the part being sorted. When the pivot was the last element
of its part in sort order (two elements in the wrong order, for one),
both scans met at the part's last element, the part split into all of
it and nothing, and the outer loop went round for ever.

The pivot now goes to the front first. Both scans are bounded, compar
never gets the pivot as both arguments, and after each pass the pivot
is put in its own place between the two parts, so every pass takes at
least one element out. As before it recurses on the smaller part, so
the stack is at most log2(nmemb) calls deep.
---
 sources/nix/stdlib/qsort.c | 84 +++++++++++++++++++++++---------------
 1 file changed, 50 insertions(+), 34 deletions(-)

diff --git a/sources/nix/stdlib/qsort.c b/sources/nix/stdlib/qsort.c
index 9168336..727137d 100644
--- a/sources/nix/stdlib/qsort.c
+++ b/sources/nix/stdlib/qsort.c
@@ -1,51 +1,67 @@
 #include <stdlib.h>
-#include "stdio.h"
 
-/* sample compar function: int cmp(void *a,void *b){ return *(int *)a-*(int *)b; } */
-
-/* This qsort function does a little trick:
- * To reduce stackspace it iterates the larger interval instead of doing
- * the recursion on both intervals. 
- * So stackspace is limited to 32*stack_for_1_iteration = 
- * 32*4*(4 arguments+1 returnaddress+11 stored registers) = 2048 Bytes,
- * which is small enough for everybodys use.
- * (And this is the worst case if you own 4GB and sort an array of chars.)
- * Sparing the function calling overhead does improve performance, too.
+/* libnix's qsort, fixed so that it ends and stays inside the array for every
+ * comparison function. Public domain, as libnix.
+ *
+ * The old one took the middle element as the pivot and left it in the array,
+ * where the scan from the left reached it and stopped only because
+ * compar(pivot, pivot) returned 0. A comparison function that never returns 0
+ * (libwebp's Huffman-tree and palette sorts: "return (a < b) ? -1 : 1;") made
+ * that scan run past the pivot and past the end of the part being sorted. When
+ * the pivot was the part's last element in sort order (any two elements in the
+ * wrong order, for one), both scans then met at the last element, the part
+ * split into all of it and nothing, and the loop below went round for ever.
+ *
+ * Here the pivot is moved to the front first. Both scans are bounded, compar
+ * never gets the pivot as both arguments, and the pivot goes to its own place
+ * between the two parts after each pass, so every pass takes at least one
+ * element out and the sort always ends.
+ *
+ * As before, it recurses on the smaller part and goes round again for the
+ * larger one, so the stack is at most log2(nmemb) calls deep.
  */
 
+static void swap(char *x,char *y,size_t size)
+{ do
+  { char tmp=*x;
+    *x++=*y;
+    *y++=tmp;
+  }while(--size);
+}
+
 void qsort
 (void *base,size_t nmemb,size_t size,int (*compar)(const void *,const void *))
 { char *base2=(char *)base;
-  size_t i,a,b,c;
+  size_t a,b;
+  if(size==0)
+    return;
   while(nmemb>1)
-  { a=0;
+  { a=(nmemb-1)/2; /* Middle element is the pivot... */
+    if(a!=0)
+      swap(base2,&base2[size*a],size); /* ...kept at the front */
+    a=1;
     b=nmemb-1;
-    c=(a+b)/2; /* Middle element */
     for(;;)
-    { while((*compar)(&base2[size*c],&base2[size*a])>0) 
-        a++; /* Look for one >= middle */
-      while((*compar)(&base2[size*c],&base2[size*b])<0) 
-        b--; /* Look for one <= middle */
+    { while(a<=b&&(*compar)(base2,&base2[size*a])>0)
+        a++; /* Look for one >= pivot */
+      while(a<=b&&(*compar)(base2,&base2[size*b])<0)
+        b--; /* Look for one <= pivot */
       if(a>=b)
         break; /* We found no pair */
-      for(i=0;i<size;i++) /* swap them */
-      { char tmp=base2[size*a+i];
-        base2[size*a+i]=base2[size*b+i];
-        base2[size*b+i]=tmp; }
-      if(c==a) /* Keep track of middle element */
-        c=b;
-      else if(c==b)
-        c=a;
+      swap(&base2[size*a],&base2[size*b],size);
       a++; /* These two are already sorted */
       b--;
-    } /* a points to first element of right intervall now (b to last of left) */
-    b++;
-    if(b<nmemb-b) /* do recursion on smaller intervall and iteration on larger one */
-    { qsort(base2,b,size,compar);
-      base2=&base2[size*b];
-      nmemb=nmemb-b; }
-    else
-    { qsort(&base2[size*b],nmemb-b,size,compar);
+    } /* 1..a-1 are <= pivot, a..nmemb-1 are >= pivot */
+    a--; /* The pivot's own place */
+    if(a!=0)
+      swap(base2,&base2[size*a],size);
+    b=nmemb-1-a; /* Elements right of the pivot */
+    if(a<b) /* do recursion on smaller interval and iteration on larger one */
+    { qsort(base2,a,size,compar);
+      base2=&base2[size*(a+1)];
       nmemb=b; }
+    else
+    { qsort(&base2[size*(a+1)],b,size,compar);
+      nmemb=a; }
   }
 }
-- 
2.43.0

